{
  "name": "collective-erp",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:website": "npm run dev --workspace=website",
    "dev:erp": "npm run dev --workspace=erp -- --port 3001",
    "build:website": "npm run build --workspace=website",
    "build:erp": "npm run build --workspace=erp",
    "build": "npm run build --workspace=website && npm run build --workspace=erp"
  },
  "dependencies": {
    "firebase": "^13.0.0"
  }
}
